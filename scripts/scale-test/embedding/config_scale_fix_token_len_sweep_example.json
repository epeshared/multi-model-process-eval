{
  "version": 1,
  "description": "Example: sweep cpu.cpus × sglang_max_total_tokens × token_lens × batch_sizes.",

  "template_auto_test_config": "scripts/auto-test/embedding/config_fix_token_len.json",
  "result_root": "scripts/scale-test/embedding/result/fix_token_len",

  "run": {
    "token_lens": [20],
    "batch_sizes": [100],
    "repeats": 1,
    "warmup_runs": 1,

    "continue_on_error": true,

    "cpu": {
      "cpus": ["0-3", "4-7"]
    },

    "sglang_max_total_tokens": ["120000", "250000"]
  },

  "job_template": {
    "backend": "sglang",
    "model": "qwen3-embedding-4b",
    "model_dir": "/mnt/nvme2n1p1/xtang/models/Qwen/Qwen3-Embedding-4B",
    "served_model_name": "Qwen3-Embedding-4B",
    "model_id": "Qwen3-Embedding-4B",

    "host": "0.0.0.0",
    "port": 30000,
    "base_url": "http://127.0.0.1:30000",

    "mode": "token_len",
    "max_samples": 50,
    "batch_size": 100,
    "dtype": "bfloat16",

    "restart_servers": true,
    "stop_server_after_job": true,
    "emon_enable": false,

    "extra_env": {
      "SGLANG_PYTHON": "/root/miniforge3/envs/sglang-cpu/bin/python"
    }
  },

  "emon": {
    "process_after_run": false
  }
}
