{
  "version": 1,
  "description": "Scale-test remote/server config (servers + remote_repo_dir/result_root + ssh/requirements). Pair with conf-job.json.",
  "run": {
    "servers": [
      {
        "ip": "82.157.169.128",
        "username": "ubuntu",
        "password": null,
        "ssh_options": [
          "ProxyCommand=nc -x proxy-shz.intel.com:1080 -X 5 %h %p",
          "ConnectTimeout=10",
          "ServerAliveInterval=30",
          "ServerAliveCountMax=3"
        ],
        "conda_env": "sglang-cpu",
        "install_requirements": true,
        "requirements_files": [
          "requirements-emon.txt",
          "requirements-mteb.txt",
          "requirements.txt"
        ],
        "pre_requirements": [
          {
            "file": "scripts/scale-test/pre-requirements/install_miniforge3_linux_x86_64.sh",
            "stage": "before_conda",
            "mode": "bash"
          },
          {
            "file": "scripts/scale-test/pre-requirements/install_sglang_system_deps.sh",
            "stage": "before_conda",
            "mode": "bash"
          },
          {
            "file": "scripts/scale-test/pre-requirements/enable_miniforge_conda.sh",
            "stage": "before_conda",
            "mode": "source"
          },
          {
            "file": "scripts/scale-test/pre-requirements/ensure_conda_env.sh",
            "stage": "before_conda",
            "mode": "bash"
          },
          {
            "file": "scripts/scale-test/pre-requirements/install_sglang.sh",
            "stage": "after_conda",
            "mode": "bash"
          },
          {
            "file": "scripts/scale-test/pre-requirements/download-models.sh",
            "stage": "after_conda",
            "mode": "bash"
          }          
        ]
      }
    ],
    "remote_repo_dir": "/home/ubuntu/multi-model-process-eval",
    "remote_result_root": "/home/ubuntu/mmpe-scale-test/embedding/result/fix_token_len",
    "remote_python": "",
    "install_requirements": false,
    "requirements_profile": "cpu",
    "requirements_files": [
      "requirements.txt"
    ],
    "pip_extra_args": [],
    "ssh": {
      "user": "root",
      "port": 22,
      "identity_file": "",
      "options": []
    }
  }
}
