{
  "version": 1,
  "description": "Scale-test: sweep SYNTHETIC_TOKEN_LEN for run_fix_token_len under CPU/memory limits, with optional EMON capture + pyedp processing.",
  "template_auto_test_config": "scripts/auto-test/embedding/config_fix_token_len.json",
  "result_root": "scripts/scale-test/embedding/result/fix_token_len",
  "run": {
    "token_lens": [
      10,
      20,
      50,
      100
    ],
    "batch_sizes": [
      50,
      100,
      200
    ],
    "repeats": 1,
    "warmup_runs": 2,
    "cpu": {
      "cpus": [
        "0-7",
        "0-15",
        "0-31"
      ]
    },
    "sglang_max_total_tokens": [
      "120000",
      "250000",
      "500000"
    ],
    "continue_on_error": true
  },
  "job_template": {
    "backend": "sglang",
    "model": "qwen3-embedding-4b",
    "model_dir": "/mnt/nvme2n1p1/xtang/models/Qwen/Qwen3-Embedding-4B",
    "served_model_name": "Qwen3-Embedding-4B",
    "model_id": "Qwen3-Embedding-4B",
    "host": "0.0.0.0",
    "port": 30000,
    "base_url": "http://127.0.0.1:30000",
    "mode": "token_len",
    "max_samples": 1000,
    "batch_size": 200,
    "dtype": "bfloat16",
    "restart_servers": true,
    "stop_server_after_job": true,
    "emon_enable": false,
    "extra_env": {
      "SGLANG_PYTHON": "/root/miniforge3/envs/sglang-cpu/bin/python"
    }
  },
  "emon": {
    "process_after_run": true,
    "process_cmd": [
      "emon",
      "-process-pyedp",
      "/opt/intel/sep/config/edp/pyedp_config.txt"
    ],
    "expected_output": "summary.xlsx"
  }
}
