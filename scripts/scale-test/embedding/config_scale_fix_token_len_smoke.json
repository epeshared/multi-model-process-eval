{
  "version": 1,
  "description": "Smoke-test: minimal scale-test run (1 job) to validate sglang-cpu environment and harness wiring.",

  "template_auto_test_config": "scripts/auto-test/embedding/config_fix_token_len.json",
  "result_root": "scripts/scale-test/embedding/result/fix_token_len_smoke",

  "run": {
    "token_lens": [20],
    "batch_sizes": [20],
    "repeats": 1,
    "warmup_runs": 1,

    "cpu": {
      "cpus": "0-31"
    },
    "memory": {
      "max_gb": 64
    }
  },

  "job_template": {
    "backend": "sglang",
    "model": "qwen3-embedding-4b",
    "model_dir": "/mnt/nvme2n1p1/xtang/models/Qwen/Qwen3-Embedding-4B",
    "served_model_name": "Qwen3-Embedding-4B",
    "model_id": "Qwen3-Embedding-4B",

    "host": "0.0.0.0",
    "port": 30000,
    "base_url": "http://127.0.0.1:30000",

    "mode": "token_len",
    "max_samples": 100,
    "batch_size": 20,
    "dtype": "bfloat16",

    "restart_servers": true,
    "stop_server_after_job": true,
    "emon_enable": false,

    "extra_env": {
      "SGLANG_PYTHON": "/root/miniforge3/envs/sglang-cpu/bin/python",
      "SGLANG_MAX_TOTAL_TOKENS": "8192",
      "SGLANG_CONTEXT_LENGTH": "512",
      "SGLANG_MEM_FRACTION_STATIC": "0.2",
      "NUMACTL_CORES": "",
      "NUMACTL_CPUNODEBIND": "",
      "NUMACTL_MEMBIND": ""
    }
  },

  "emon": {
    "process_after_run": false,
    "process_cmd": [
      "emon",
      "-process-pyedp",
      "/opt/intel/sep/config/edp/pyedp_config.txt"
    ],
    "expected_output": "summary.xlsx"
  }
}
