{
  "version": 1,
  "description": "Auto-test for scripts/embedding/run_embedding_yahoo.sh (writes raw logs + parsed tps/latency into scripts/auto-test/embedding/result). Use the other per-script configs for run_fix_token_len / run_mteb.",
  "script_aliases": {
    "run_embedding_yahoo": "scripts/embedding/run_embedding_yahoo.sh"
  },
  "defaults": {
    "cwd": ".",
    "result_dir": "scripts/auto-test/embedding/result/yahoo",
    "timeout_sec": 21600,
    "restart_servers": true,
    "env": {
      "PYTHONUNBUFFERED": "1",
      "DATASET_PATH": "/mnt/nvme2n1p1/xtang/datasets/yahoo_answers_title_answer.jsonl"
    }
  },
  "servers": {
    "sglang": {
      "enabled": true,
      "start_script": "scripts/embedding/sglang/start_sglang_server.sh",
      "cwd": "scripts/embedding/sglang",
      "args": [],
      "env": {},
      "numactl": {
        "cores": "0-15",
        "cpunodebind": "",
        "membind": ""
      },
      "env_from_job": {
        "MODEL_DIR": "MODEL_DIR",
        "HOST": "HOST",
        "PORT": "PORT",
        "BATCH_SIZE": "SERVER_BATCH_SIZE"
      },
      "ready": {
        "endpoints": ["POST /v1/embeddings", "/v1/models", "/health"],
        "timeout_sec": 1200,
        "interval_sec": 2
      }
    },
    "vllm-http": {
      "enabled": true,
      "start_script": "scripts/embedding/vllm/start_vllm_server.sh",
      "cwd": "scripts/embedding/vllm",
      "args": [],
      "env": {},
      "numactl": {
        "cores": "0-15",
        "cpunodebind": "",
        "membind": ""
      },
      "env_from_job": {
        "MODEL_DIR": "MODEL_DIR",
        "SERVED_MODEL_NAME": "SERVED_MODEL_NAME",
        "HOST": "HOST",
        "PORT": "PORT"
      },
      "ready": {
        "endpoints": ["POST /v1/embeddings", "/v1/models", "/health"],
        "timeout_sec": 1800,
        "interval_sec": 2
      }
    }
  },
  "jobs": [
    {
      "name": "yahoo_qwen3-embedding-4b_sglang-online",
      "script": "run_embedding_yahoo",
      "args": [],
      "warmup_runs": 2,
      "env": {
        "MODEL": "qwen3-embedding-4b",
        "MODEL_DIR": "/mnt/nvme2n1p1/xtang/models/Qwen/Qwen3-Embedding-4B",
        "MODEL_ID": "Qwen3-Embedding-4B",
        "BACKEND": "sglang",
        "NUMACTL_CORES": "",
        "NUMACTL_CPUNODEBIND": "",
        "NUMACTL_MEMBIND": "",
        "HOST": "0.0.0.0",
        "PORT": "30000",
        "BASE_URL": "http://127.0.0.1:30000",
        "MAX_SAMPLES": "2000",
        "BATCH_SIZE": "100",
        "SERVER_BATCH_SIZE": "16",
        "YAHOO_MODE": "q"
      }
    },
    {
      "name": "yahoo_qwen3-embedding-4b_vllm-http",
      "script": "run_embedding_yahoo",
      "args": [],
      "warmup_runs": 2,
      "env": {
        "MODEL": "qwen3-embedding-4b",
        "MODEL_DIR": "/mnt/nvme2n1p1/xtang/models/Qwen/Qwen3-Embedding-4B",
        "SERVED_MODEL_NAME": "Qwen3-Embedding-4B",
        "MODEL_ID": "Qwen3-Embedding-4B",
        "BACKEND": "vllm-http",
        "NUMACTL_CORES": "",
        "NUMACTL_CPUNODEBIND": "",
        "NUMACTL_MEMBIND": "",
        "HOST": "0.0.0.0",
        "PORT": "9090",
        "BASE_URL": "http://127.0.0.1:9090",
        "MAX_SAMPLES": "2000",
        "BATCH_SIZE": "100",
        "YAHOO_MODE": "q"
      }
    }
  ]
}
